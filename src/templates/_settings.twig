{# @var plugin \ghoststreet\craftincrementalstaticregeneration\Plugin #}
{# @var settings \ghoststreet\craftincrementalstaticregeneration\models\Settings #}

{% import '_includes/forms.twig' as forms %}

<h2>Settings</h2>

<div class="field">
  {% if craft.app.config.general.allowAdminChanges %}
    <div class="heading">
      <label id="settings-isEnabled-label" for="isEnabled">
        Plugin Enabled
      </label>
    </div>
    {{
      forms.booleanMenu({
        id: 'isEnabled',
        name: 'isEnabled',
        value: settings.isEnabled,
        includeEnvVars: true,
        errors: settings.getErrors('isEnabled')
      })
    }}
  </div>
  {% else %}
    <div class="heading">
      {% if settings.getIsEnabled() %}
        ✅ ISR cache busting enabled
      {% else %}
        ❌ ISR cache busting disabled
      {% endif %}
    </div>
  {% endif %}

{{
  forms.autosuggestField({
    label: 'Craft site URL to replace',
    instruction: 'Insert the URL of the craft site to replace if not using headless mode',
    id: 'siteToReplace',
    name: 'siteToReplace',
    value: settings.siteToReplace,
    suggestEnvVars: true,
    required: false,
    errors: settings.getErrors('siteToReplace')
  })
}}


{{
  forms.autosuggestField({
    label: 'Front End site URL',
    instruction: 'Insert the URL of the front end site using ISR',
    id: 'targetSite',
    name: 'targetSite',
    value: settings.targetSite,
    suggestEnvVars: true,
    required: false,
    errors: settings.getErrors('targetSite')
  })
}}

{{
  forms.autosuggestField({
    label: 'ISR Bypass token',
    instruction: 'ISR Bypass token setup in svelte',
    id: 'isrBypassToken',
    name: 'isrBypassToken',
    value: settings.isrBypassToken,
    suggestEnvVars: true,
    required: false,
    errors: settings.getErrors('isrBypassToken')
  })
}}


{{
  forms.autosuggestField({
    label: 'Vercel Deploy Hook',
    instruction: 'Insert the URL deploy hook in vercel',
    id: 'deployHook',
    name: 'deployHook',
    value: settings.deployHook,
    suggestEnvVars: true,
    required: false,
    errors: settings.getErrors('deployHook')
  })
}}

{{
  forms.textareaField({
    label: 'Extra paths to revalidate',
    instruction: 'Listing pages to revalidate when an entry in a section changes, one section per line as `sectionHandle: /path, /other-path`. Use `*` to match every section.',
    id: 'revalidatePaths',
    name: 'revalidatePaths',
    value: settings.revalidatePaths,
    rows: 4,
    placeholder: "blog: /blog, /\n*: /sitemap.xml",
    errors: settings.getErrors('revalidatePaths')
  })
}}
